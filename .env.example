# Скопируйте в .env на сервере. Не публикуйте .env и не коммитьте секреты.
PORT=3000
HOST=127.0.0.1
# Для контейнера, где порт публикуется платформой, задайте HOST=0.0.0.0.

# Итоговый origin сайта без пути и завершающего слеша.
# В локальной разработке можно оставить пустым.
PUBLIC_ORIGIN=
# Публичный HTTPS URL для canonical/Open Graph при npm run build.
SITE_URL=https://htss-co.kz/
# Необязательно: по умолчанию сервер использует dist, если там есть index.html.
PUBLIC_DIR=

# Укажите действующий адрес получателя. Пустое значение отключает приём заявок.
CONTACT_TO=info@htss-co.kz
# Текущий сайт использует FormSubmit без SMTP. Для своего SMTP: CONTACT_PROVIDER=auto.
CONTACT_PROVIDER=formsubmit
# Подтверждённый адрес отправителя у вашего почтового провайдера.
CONTACT_FROM=
SMTP_HOST=
SMTP_PORT=587
# false: обязательный STARTTLS (обычно порт 587); true: TLS сразу (обычно 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Только за одним доверенным reverse proxy, который перезаписывает X-Forwarded-For.
# Никогда не включайте, если Node напрямую доступен из интернета.
TRUST_PROXY=false
